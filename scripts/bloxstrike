local State = {
    Aimbot = false,
    AimbotTarget = nil,
    AimbotTeamCheck = false,
    AimbotWallCheck = false,
    AimbotSmoothness = 1,
    SilentAim = false,
    SilentAimTarget = nil,
    SilentAimFOVVisible = true,
    SilentAimFOVRadius = 120,
    SilentAimTeamCheck = false,
    SilentAimWallCheck = false,
    NoRecoil = false,
    NoBob = false,
    NoSway = false,
    Ragebot = false,
    RageWallbang = true,
    RageTarget = nil,
    Wallbang = false,
    Hitsounds = false,
    HitsoundPack = 'cs:go',
    RemoveGameHit = false,
    Spinbot = false,
    SpinbotSpeed = 360,
    ThirdPerson = false,
    MusicEnabled = false,
    MusicTrack = 'among us theme',
    Tracers = false,
    TracerColor = Color3.new(1, 1, 1),
    DamageNumbers = false,
    DamageNumberColor = Color3.fromRGB(255, 255, 0),
}
