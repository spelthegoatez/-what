AimSec:AddToggle('wall check', false, function(on) State.AimbotWallCheck = on end):DependsOn(AimbotToggle, true)
AimSec:AddSlider('smoothness', 0, 1, 1, function(v) State.AimbotSmoothness = v end):DependsOn(AimbotToggle, true)

