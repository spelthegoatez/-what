local function updateFOVCircle()
    local size = State.SilentAimFOVRadius * 2
    fovCircle.Size = UDim2.fromOffset(size, size)
    fovCircle.Visible = State.SilentAimFOVVisible and State.SilentAim
end

updateFOVCircle()

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

local function isVisible(part)
    if not part then return false end
    local char = LocalPlayer.Character
    local ignoreList = { char }
    if workspace:FindFirstChild('Ignored') then table.insert(ignoreList, workspace.Ignored) end
    rayParams.FilterDescendantsInstances = ignoreList
    local origin = Camera.CFrame.Position
    local dir = part.Position - origin
    local hit = workspace:Raycast(origin, dir, rayParams)
    if not hit then return true end
    return hit.Instance:IsDescendantOf(part.Parent)
end

CameraController.setWeaponRecoil = function(...)
    if State.NoRecoil then return end
    if Originals.setWeaponRecoil then return Originals.setWeaponRecoil(...) end
end
CameraController.weaponKick = function(...)
    if State.NoRecoil then return end
    if Originals.weaponKick then return pcall(Originals.weaponKick, ...) end
end

pcall(function()
    local ClientFighter = require(LocalPlayer.PlayerScripts.Modules.ClientReplicatedClasses.ClientFighter)
    if ClientFighter and type(ClientFighter.GetCameraSway) == 'function' then
        local oldSway = ClientFighter.GetCameraSway
        ClientFighter.GetCameraSway = function(self, ...)
            if State.NoSway then return 0 end
            return oldSway(self, ...)
        end
    end
end)

local BOBBLE_NAMES = {
    'addScopeKick', 'addKick', 'addBobble', 'addBobbleKick',
    'addScopeBobble', 'addRecoil', 'addWeaponKick', 'kick',
}

local function applyRecoil(w)
    if not w or not w.Recoil then return end
    if not Originals.recoilFn[w] then Originals.recoilFn[w] = w.Recoil.Function end
    if State.NoRecoil then
        pcall(function()
            w.Recoil.Function = function() return Vector2.zero end
            w.Recoil.Value = Vector2.zero
            w.Recoil.RotationValue = Vector3.zero
            w.Recoil.RecoveryValue = Vector2.zero
            w.Recoil.Time = 0
        end)
    else
        pcall(function() w.Recoil.Function = Originals.recoilFn[w] end)
    end
end

local function applyBobble(w)
    if not w or not w.Viewmodel then return end
    local bobble = w.Viewmodel.Bobble
    if not bobble then return end
    if not Originals.bobbleMethods[bobble] then
        Originals.bobbleMethods[bobble] = {}
        for _, name in ipairs(BOBBLE_NAMES) do
            local fn = bobble[name]
            if type(fn) == 'function' then
                Originals.bobbleMethods[bobble][name] = fn
            end
        end
    end
    if State.NoBob then
        for name in pairs(Originals.bobbleMethods[bobble]) do
            pcall(function() bobble[name] = function() end end)
        end
    else
        for name, fn in pairs(Originals.bobbleMethods[bobble]) do
            pcall(function() bobble[name] = fn end)
        end
    end
end

local function applyWeapon(w)
    if not w then return end
    Originals.tracked[w] = true
    applyRecoil(w)
    applyBobble(w)
end

local function reapplyAll()
    for w in pairs(Originals.tracked) do
        if w and w.Parent then
            applyRecoil(w)
            applyBobble(w)
        else
            Originals.tracked[w] = nil
        end
    end
end

local function getAimbotTarget()
    local MyTeam = LocalPlayer:GetAttribute('Team')
    local screenCenter = Camera.ViewportSize * 0.5
    local Best, BestDist
    for _, Character in ipairs(Characters:GetChildren()) do
        if Character.Name == LocalPlayer.Name then continue end
        local Player = Players:FindFirstChild(Character.Name)
        if not Player then continue end
        if State.AimbotTeamCheck and Player:GetAttribute('Team') == MyTeam then continue end
        if Character:GetAttribute('Dead') == true then continue end
        if (Character:GetAttribute('Health') or 0) <= 0 then continue end
        local Head = Character:FindFirstChild('Head')
        if not Head then continue end
        local screenPos, onScreen = Camera:WorldToViewportPoint(Head.Position)
        if not onScreen then continue end
        local dist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
        if dist > State.SilentAimFOVRadius then continue end
        if State.AimbotWallCheck and not isVisible(Head) then continue end
        if not BestDist or dist < BestDist then
            BestDist = dist
            Best = Head
        end
    end
    return Best
end

RunService:BindToRenderStep('AimbotLoop', Enum.RenderPriority.Camera.Value + 1, function(dt)
    if not State.Aimbot then
        State.AimbotTarget = nil
        return
    end
    local target = getAimbotTarget()
    State.AimbotTarget = target
    if not target then return end
    local camPos = Camera.CFrame.Position
    local desired = CFrame.lookAt(camPos, target.Position)
    local smooth = math.clamp(State.AimbotSmoothness, 0, 1)
    local alpha
    if smooth <= 0 then alpha = 1 else alpha = math.max(0.01, (1 - smooth) ^ 2) end
    Camera.CFrame = Camera.CFrame:Lerp(desired, alpha)
end)

local function getMuzzlePosition(weapon)
    if weapon and weapon.Viewmodel and weapon.Viewmodel.Model then
        local interactables = weapon.Viewmodel.Model:FindFirstChild('Interactables')
        if interactables then
            local muzzle = interactables:FindFirstChild('MuzzlePart')
            if muzzle and muzzle:IsA('BasePart') then
                return muzzle.Position
            end
        end
    end
    local char = LocalPlayer.Character
    if char then
        local rightHand = char:FindFirstChild('RightHand') or char:FindFirstChild('RightUpperArm')
        if rightHand then
            return rightHand.Position + rightHand.CFrame.LookVector * 2
        end
        local head = char:FindFirstChild('Head')
        if head then return head.Position end
    end
    return Camera.CFrame.Position
end

local function getWeaponFireOrigin()
    local char = LocalPlayer.Character
    if not char then return Camera.CFrame.Position end
    local weapon = char:FindFirstChildOfClass('Tool')
    if weapon and weapon:FindFirstChild('Barrel') then
        return weapon.Barrel.Position
    end
    local rightHand = char:FindFirstChild('RightHand') or char:FindFirstChild('RightUpperArm')
    if rightHand then
        return rightHand.Position + rightHand.CFrame.LookVector * 2
    end
    return Camera.CFrame.Position
end

local function getSilentAimTarget()
    local MyTeam = LocalPlayer:GetAttribute('Team')
    local screenCenter = Camera.ViewportSize * 0.5
    local Best, BestDist
    for _, Character in ipairs(Characters:GetChildren()) do
        if Character.Name == LocalPlayer.Name then continue end
        local Player = Players:FindFirstChild(Character.Name)
        if not Player then continue end
        if State.SilentAimTeamCheck and Player:GetAttribute('Team') == MyTeam then continue end
        if Character:GetAttribute('Dead') == true then continue end
        if (Character:GetAttribute('Health') or 0) <= 0 then continue end
        local Head = Character:FindFirstChild('Head')
        if not Head then continue end
        local screenPos, onScreen = Camera:WorldToViewportPoint(Head.Position)
        if not onScreen then continue end
        local dist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
        if dist > State.SilentAimFOVRadius then continue end
        if State.SilentAimWallCheck and not State.Wallbang and not isVisible(Head) then continue end
        if not BestDist or dist < BestDist then
            BestDist = dist
            Best = Head
        end
    end
    return Best
end

RunService.RenderStepped:Connect(function()
    if State.SilentAim then
        State.SilentAimTarget = getSilentAimTarget()
    else
        State.SilentAimTarget = nil
    end
end)

local function getRageTarget()
    local MyTeam = LocalPlayer:GetAttribute('Team')
    local Closest = 500
    local Best
    for _, Character in ipairs(Characters:GetChildren()) do
        if Character.Name == LocalPlayer.Name then continue end
        local Player = Players:FindFirstChild(Character.Name)
        if not Player or Player:GetAttribute('Team') == MyTeam then continue end
        if Character:GetAttribute('Dead') == true then continue end
        if (Character:GetAttribute('Health') or 0) <= 0 then continue end
        local Head = Character:FindFirstChild('Head')
        if not Head then continue end
        local _, OnScreen = Camera:WorldToViewportPoint(Head.Position)
        if not OnScreen then continue end
        if not State.RageWallbang and not isVisible(Head) then continue end
        local Dist = (Head.Position - Camera.CFrame.Position).Magnitude
        if Dist < Closest then
            Closest = Dist
            Best = Head
        end
    end
    return Best
end

RunService.RenderStepped:Connect(function()
    if State.Ragebot then
        State.RageTarget = getRageTarget()
    else
        State.RageTarget = nil
    end
end)

pcall(function()
    for _, v in next, getgc(true) do
        if type(v) == 'table' and rawget(v, 'cast') and type(v.cast) == 'function' then
            local old
            old = hookfunction(v.cast, function(...)
                local args = { ... }
                local target
                if State.Ragebot and State.RageTarget then
                    target = State.RageTarget
                elseif State.SilentAim and State.SilentAimTarget then
                    target = State.SilentAimTarget
                end
                if target and args[2] and typeof(args[2]) == 'Vector3' then
                    args[2] = (target.Position - args[1])
                end
                return old(unpack(args))
            end)
        end
    end
end)

local OldRaycast = Bullet._performRaycast

Bullet._performRaycast = function(Self, Spread)
    local Result = OldRaycast(Self, Spread)

    if not Result then
        return Result
    end

    if State.Ragebot and State.RageTarget then
        local target = State.RageTarget
        local Position = target.Position
        local Offset = Position - Result.Origin
        local Dir = Offset.Unit
        Result.Direction = Dir
        Result.Distance = Offset.Magnitude
        if State.RageWallbang then
            Result.Hits = {
                {
                    Position = Position,
                    Instance = target,
                    Material = 'Plastic',
                    Normal = -Dir,
                    Exit = false,
                },
            }
        end
    elseif State.SilentAim and State.SilentAimTarget then
        local target = State.SilentAimTarget
        local Position = target.Position
        local fireOrigin = getWeaponFireOrigin()
        local Offset = Position - fireOrigin
        local Dir = Offset.Unit
        Result.Direction = Dir
        Result.Distance = Offset.Magnitude
        if State.Wallbang then
            Result.Hits = {
                {
                    Position = Position,
                    Instance = target,
                    Material = 'Plastic',
                    Normal = -Dir,
                    Exit = false,
                },
            }
        end
    elseif State.Wallbang then
        local origin = Result.Origin
        local dir = Result.Direction
        if origin and dir and dir.Magnitude > 0 then
            local charList = {}
            for _, c in ipairs(Characters:GetChildren()) do
                if c.Name ~= LocalPlayer.Name then
                    table.insert(charList, c)
                end
            end
            local wp = RaycastParams.new()
            wp.FilterType = Enum.RaycastFilterType.Include
            wp.FilterDescendantsInstances = charList
            wp.IgnoreWater = true
            local weapon = Self and Self.Weapon
            local range = (weapon and weapon.Properties and weapon.Properties.Range) or 500
            local newHit = workspace:Raycast(origin, dir.Unit * range, wp)
            if newHit then
                local offset = newHit.Position - origin
                Result.Direction = offset.Unit
                Result.Distance = offset.Magnitude
                Result.Hits = {
                    {
                        Position = newHit.Position,
                        Instance = newHit.Instance,
                        Material = (newHit.Material and newHit.Material.Name) or 'Plastic',
                        Normal = newHit.Normal,
                        Exit = false,
                    },
                }
            else
                Result.Direction = dir.Unit
                Result.Distance = math.max(Result.Distance, range)
                Result.Hits = {}
            end
        end
    end

    if State.Tracers then
        local dirUnit = Result.Direction
        if typeof(dirUnit) == 'Vector3' and dirUnit.Magnitude > 0 then
            dirUnit = dirUnit.Unit
        else
            dirUnit = Vector3.new(0, 0, -1)
        end

        local weapon = Self and Self.Weapon
        local range = (weapon and weapon.Properties and weapon.Properties.Range) or 500

        local startPos = getMuzzlePosition(weapon)
        local endPos = Result.Origin + dirUnit * range

        createTracer(startPos, endPos)
    end

    if State.Hitsounds and Result.Hits then
        for _, hit in ipairs(Result.Hits) do
            if partIsEnemy(hit.Instance) then
                playHitsound()
                break
            end
        end
    end

    return Result
end

task.spawn(function()
    while task.wait(0.5) do
        local w = invhandler.getCurrentEquipped()
        if w then applyWeapon(w) end
    end
end)

task.spawn(function()
    while true do
        RunService.PreRender:Wait()
        if State.Ragebot then
            local w = invhandler.getCurrentEquipped()
            if State.RageTarget and w and w.IsEquipped and w.Rounds > 0 then
                pcall(function() w:shoot() end)
            end
        end
        if State.NoSway then
            local w = invhandler.getCurrentEquipped()
            local vm = w and w.Viewmodel
            local sway = vm and vm._sway_spring
            if sway then
                pcall(function()
                    sway.Target = Vector2.zero
                    sway.Value = Vector2.zero
                    sway.Velocity = Vector2.zero
                end)
            end
        end
    end
end)

local http_service = game:GetService('HttpService')
local vec2 = Vector2.new
local dim2 = UDim2.new
local dim_offset = UDim2.fromOffset
local rgb = Color3.fromRGB

local esp_flags = {
    Enabled = false, TeamCheck = true, Names = true,
    Name_Color = { Color = rgb(255, 255, 255) },
    Boxes = true, Box_Type = 'Normal',
    Box_Color = { Color = rgb(255, 255, 255) },
    Healthbar = true,
    Health_High = { Color = rgb(0, 255, 0) },
    Health_Low = { Color = rgb(255, 0, 0) },
    Distance = true, Distance_Color = { Color = rgb(255, 255, 255) },
    Weapon = true, Weapon_Color = { Color = rgb(255, 255, 255) },
    Skeletons = true, Skeletons_Color = { Color = rgb(255, 255, 255) },
}

local boneList = {
    { 'Head', 'UpperTorso' }, { 'UpperTorso', 'LowerTorso' },
    { 'UpperTorso', 'LeftUpperArm' }, { 'UpperTorso', 'RightUpperArm' },
    { 'LeftUpperArm', 'LeftLowerArm' }, { 'RightUpperArm', 'RightLowerArm' },
    { 'LowerTorso', 'LeftUpperLeg' }, { 'LowerTorso', 'RightUpperLeg' },
    { 'LeftUpperLeg', 'LeftLowerLeg' }, { 'RightUpperLeg', 'RightLowerLeg' },
}

local fonts = { main = Font.fromEnum(Enum.Font.Code) }

pcall(function()
    if typeof(writefile) ~= 'function' or typeof(getcustomasset) ~= 'function' then return end
    local function registerFont(Name, Weight, Style, Asset)
        if not isfile(Asset.Id) then writefile(Asset.Id, Asset.Font) end
        if isfile(Name .. '.font') then delfile(Name .. '.font') end
        local Data = { name = Name, faces = { { name = 'Normal', weight = Weight, style = Style, assetId = getcustomasset(Asset.Id) } } }
        writefile(Name .. '.font', http_service:JSONEncode(Data))
        return getcustomasset(Name .. '.font')
    end
    local ProggyTiny = registerFont('prog_tiny_custom_', 100, 'Normal', {
        Id = 'ProggyTiny_custom.ttf',
        Font = game:HttpGet('https://github.com/i77lhm/storage/raw/refs/heads/main/fonts/ProggyTiny.ttf'),
    })
    fonts.main = Font.new(ProggyTiny, Enum.FontWeight.Regular, Enum.FontStyle.Normal)
end)

local esp = { players = {}, cache = nil, screengui = nil }

do
    local parentGui = (typeof(gethui) == 'function' and gethui()) or game:GetService('CoreGui')
    esp.screengui = Instance.new('ScreenGui', parentGui)
    esp.screengui.IgnoreGuiInset = true
    esp.screengui.Name = '\0'
    esp.screengui.ResetOnSpawn = false
    esp.screengui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    esp.cache = Instance.new('ScreenGui', parentGui)
    esp.cache.Name = '\0cache'
    esp.cache.Enabled = false
    esp.cache.ResetOnSpawn = false

    function esp:get_screen_pos(world_position)
        local viewport_size = Camera.ViewportSize
        local local_position = Camera.CFrame:PointToObjectSpace(world_position)
        local aspect_ratio = viewport_size.X / viewport_size.Y
        local half_height = -local_position.Z * math.tan(math.rad(Camera.FieldOfView / 2))
        local half_width = aspect_ratio * half_height
        local far_plane_corner = Vector3.new(-half_width, half_height, local_position.Z)
        local relative_position = local_position - far_plane_corner
        local screen_x = relative_position.X / (half_width * 2)
        local screen_y = -relative_position.Y / (half_height * 2)
        local is_on_screen = -local_position.Z > 0 and screen_x >= 0 and screen_x <= 1 and screen_y >= 0 and screen_y <= 1
        return Vector3.new(screen_x * viewport_size.X, screen_y * viewport_size.Y, -local_position.Z), is_on_screen
    end

    function esp:box_solve(torso)
        if not torso then return nil, nil, nil, nil end
        local ViewportTop = torso.Position + (torso.CFrame.UpVector * 1.8) + Camera.CFrame.UpVector
        local ViewportBottom = torso.Position - (torso.CFrame.UpVector * 2.5) - Camera.CFrame.UpVector
        local Distance = (torso.Position - Camera.CFrame.Position).Magnitude
        local Top, TopIsRendered = esp:get_screen_pos(ViewportTop)
        local Bottom, BottomIsRendered = esp:get_screen_pos(ViewportBottom)
        local Width = math.max(math.floor(math.abs(Top.X - Bottom.X)), 3)
        local Height = math.max(math.floor(math.max(math.abs(Bottom.Y - Top.Y), Width / 2)), 3)
        local BoxSize = Vector2.new(math.floor(math.max(Height / 1.5, Width)), Height)
        local BoxPosition = Vector2.new(math.floor(Top.X * 0.5 + Bottom.X * 0.5 - BoxSize.X * 0.5), math.floor(math.min(Top.Y, Bottom.Y)))
        return BoxSize, BoxPosition, (TopIsRendered and BottomIsRendered), Distance
    end

    function esp:create(instance, options)
        local ins = Instance.new(instance)
        for prop, value in options do ins[prop] = value end
        return ins
    end

    function esp:isEnemy(Character)
        if not Character or not Character.Parent then return false end
        if Character.Name == LocalPlayer.Name then return false end
        local Player = Players:FindFirstChild(Character.Name)
        if not Player then return false end
        if esp_flags.TeamCheck and Player:GetAttribute('Team') == LocalPlayer:GetAttribute('Team') then return false end
        if Character:GetAttribute('Dead') == true then return false end
        if (Character:GetAttribute('Health') or 0) <= 0 then return false end
        return true
    end

    function esp:create_object(Character)
        local Player = Players:FindFirstChild(Character.Name)
        if not Player then return end
        esp[Character.Name] = { objects = {}, info = { character = Character, player = Player }, drawings = {}, conns = {} }
        local data = esp[Character.Name]
        local objects = data.objects

        objects.holder = esp:create('Frame', {
            Parent = esp.screengui, Name = '\0', BackgroundTransparency = 1,
            Position = dim2(0, 0, 0, 0), BorderColor3 = rgb(0, 0, 0),
            Size = dim2(0, 0, 0, 0), BorderSizePixel = 0,
            BackgroundColor3 = rgb(255, 255, 255), Visible = false,
        })
        objects.box_outline = esp:create('UIStroke', {
            Parent = (esp_flags.Boxes and esp_flags.Box_Type ~= 'Corner' and objects.holder) or esp.cache,
            LineJoinMode = Enum.LineJoinMode.Miter, Thickness = 1, Color = rgb(0, 0, 0),
        })
        objects.name = esp:create('TextLabel', {
            FontFace = fonts.main, Parent = objects.holder, TextColor3 = esp_flags.Name_Color.Color,
            BorderColor3 = rgb(0, 0, 0), Text = string.format('%s (@%s)', Player.DisplayName, Player.Name),
            Name = '\0', TextStrokeTransparency = 0, AnchorPoint = vec2(0, 1),
            Size = dim2(1, 0, 0, 0), BackgroundTransparency = 1, Position = dim2(0, 0, 0, -5),
            BorderSizePixel = 0, AutomaticSize = Enum.AutomaticSize.Y, TextSize = 9,
        })
        objects.box_handler = esp:create('Frame', {
            Parent = (esp_flags.Boxes and esp_flags.Box_Type ~= 'Corner' and objects.holder) or esp.cache,
            Name = '\0', BackgroundTransparency = 1, Position = dim2(0, 1, 0, 1),
            BorderColor3 = rgb(0, 0, 0), Size = dim2(1, -2, 1, -2),
            BorderSizePixel = 0, BackgroundColor3 = rgb(255, 255, 255),
        })
        objects.box_color = esp:create('UIStroke', {
            Color = esp_flags.Box_Color.Color, LineJoinMode = Enum.LineJoinMode.Miter,
            Name = '\0', Thickness = 1, Parent = objects.box_handler,
        })
        objects.outline = esp:create('Frame', {
            Parent = objects.box_handler, Name = '\0', BackgroundTransparency = 1,
            Position = dim2(0, 1, 0, 1), BorderColor3 = rgb(0, 0, 0),
            Size = dim2(1, -2, 1, -2), BorderSizePixel = 0,
            BackgroundColor3 = rgb(255, 255, 255),
        })
        esp:create('UIStroke', {
            Parent = objects.outline, LineJoinMode = Enum.LineJoinMode.Miter,
            Thickness = 1, Color = rgb(0, 0, 0),
        })
        objects.corners = esp:create('Frame', {
            Visible = true, BorderColor3 = rgb(0, 0, 0),
            Parent = (esp_flags.Boxes and esp_flags.Box_Type == 'Corner' and objects.holder) or esp.cache,
            BackgroundTransparency = 1, Position = dim2(0, -1, 0, 2), Name = '\0',
            Size = dim2(1, 0, 1, 0), BorderSizePixel = 0,
            BackgroundColor3 = rgb(255, 255, 255),
        })

        local cornerDefs = {
            { anchor = vec2(0, 0), pos = dim2(0, 0, 0, -2), size = dim2(0.4, 0, 0, 3), innerPos = dim2(0, 1, 0, 1), innerSize = dim2(1, -2, 1, -2), rot = 0 },
            { anchor = vec2(0, 0), pos = dim2(0, 0, 0, 1), size = dim2(0, 3, 0.25, 0), innerPos = dim2(0, 1, 0, -2), innerSize = dim2(1, -2, 1, 1), rot = 0 },
            { anchor = vec2(1, 0), pos = dim2(1, 0, 0, -2), size = dim2(0.4, 0, 0, 3), innerPos = dim2(0, 1, 0, 1), innerSize = dim2(1, -2, 1, -2), rot = 0 },
            { anchor = vec2(1, 0), pos = dim2(1, 0, 0, 1), size = dim2(0, 3, 0.25, 0), innerPos = dim2(0, 1, 0, -2), innerSize = dim2(1, -2, 1, 1), rot = 0 },
            { anchor = vec2(0, 1), pos = dim2(0, 0, 1, -2), size = dim2(0.4, 0, 0, 3), innerPos = dim2(0, 1, 0, 1), innerSize = dim2(1, -2, 1, -2), rot = 0 },
            { anchor = vec2(0, 1), pos = dim2(0, 0, 1, -5), size = dim2(0, 3, 0.25, 0), innerPos = dim2(0, 1, 0, -2), innerSize = dim2(1, -2, 1, 1), rot = 180 },
            { anchor = vec2(1, 1), pos = dim2(1, 0, 1, -2), size = dim2(0.4, 0, 0, 3), innerPos = dim2(0, 1, 0, 1), innerSize = dim2(1, -2, 1, -2), rot = 0 },
            { anchor = vec2(1, 1), pos = dim2(1, 0, 1, -5), size = dim2(0, 3, 0.25, 0), innerPos = dim2(0, 1, 0, -2), innerSize = dim2(1, -2, 1, 1), rot = 180 },
        }

        for _, def in ipairs(cornerDefs) do
            local outer = esp:create('Frame', {
                Parent = objects.corners, Name = 'line', Position = def.pos,
                AnchorPoint = def.anchor, BorderColor3 = rgb(0, 0, 0),
                Size = def.size, BorderSizePixel = 0,
                BackgroundColor3 = rgb(0, 0, 0), Rotation = def.rot,
            })
            esp:create('Frame', {
                Parent = outer, Position = def.innerPos, BorderColor3 = rgb(0, 0, 0),
                Size = def.innerSize, BorderSizePixel = 0,
                BackgroundColor3 = esp_flags.Box_Color.Color,
            })
        end

        objects.healthbar_holder = esp:create('Frame', {
            AnchorPoint = vec2(1, 0),
            Parent = esp_flags.Healthbar and objects.holder or esp.cache,
            Name = '\0', Position = dim2(0, -5, 0, -1), BorderColor3 = rgb(0, 0, 0),
            Size = dim2(0, 4, 1, 2), BorderSizePixel = 0, BackgroundColor3 = rgb(0, 0, 0),
        })
        objects.healthbar = esp:create('Frame', {
            Parent = objects.healthbar_holder, Name = '\0',
            Position = dim2(0, 1, 0, 1), BorderColor3 = rgb(0, 0, 0),
            Size = dim2(1, -2, 1, -2), BorderSizePixel = 0,
            BackgroundColor3 = rgb(255, 255, 255),
        })
        objects.distance = esp:create('TextLabel', {
            FontFace = fonts.main, TextColor3 = esp_flags.Distance_Color.Color,
            BorderColor3 = rgb(0, 0, 0), Text = '',
            Parent = esp_flags.Distance and objects.holder or esp.cache,
            TextStrokeTransparency = 0, Name = '\0',
            Size = dim2(1, 0, 0, 0), BackgroundTransparency = 1,
            Position = dim2(0, 0, 1, 5), BorderSizePixel = 0,
            AutomaticSize = Enum.AutomaticSize.Y, TextSize = 9,
        })
        objects.weapon = esp:create('TextLabel', {
            FontFace = fonts.main, TextColor3 = esp_flags.Weapon_Color.Color,
            BorderColor3 = rgb(0, 0, 0), Text = '', Parent = esp.cache,
            TextStrokeTransparency = 0, Name = '\0',
            Size = dim2(1, 0, 0, 0), BackgroundTransparency = 1,
            Position = dim2(0, 0, 1, 19), BorderSizePixel = 0,
            AutomaticSize = Enum.AutomaticSize.Y, TextSize = 9,
        })

        for _ = 1, #boneList do
            local line = Drawing.new('Line')
            line.Color = esp_flags.Skeletons_Color.Color
            line.Thickness = 1
            line.Visible = false
            data.drawings[#data.drawings + 1] = line
        end

        data.health_changed = function()
            if not esp_flags.Healthbar then return end
            local character = data.info.character
            if not character or not character.Parent then return end
            local health = character:GetAttribute('Health') or 0
            local maxHealth = character:GetAttribute('MaxHealth') or 100
            local multiplier = math.clamp(health / math.max(maxHealth, 1), 0, 1)
            local hcol = esp_flags.Health_Low.Color:Lerp(esp_flags.Health_High.Color, multiplier)
            objects.healthbar.Size = UDim2.new(1, -2, multiplier, -2)
            objects.healthbar.Position = UDim2.new(0, 1, 1 - multiplier, 1)
            objects.healthbar.BackgroundColor3 = hcol
        end

        data.tool_added = function()
            local character = data.info.character
            if not character or not character.Parent then return end
            local tool = character:FindFirstChildOfClass('Tool')
            if tool then
                objects.weapon.Text = tool.Name
                objects.weapon.Parent = objects.holder
            else
                objects.weapon.Text = ''
                objects.weapon.Parent = esp.cache
            end
        end

        data.refresh_descendants = function()
            for _, c in ipairs(data.conns) do pcall(function() c:Disconnect() end) end
            data.conns = {}
            local character = data.info.character
            if not character or not character.Parent then return end
            table.insert(data.conns, character:GetAttributeChangedSignal('Health'):Connect(data.health_changed))
            table.insert(data.conns, character.ChildAdded:Connect(data.tool_added))
            table.insert(data.conns, character.ChildRemoved:Connect(data.tool_added))
            data.health_changed()
            data.tool_added()
        end

        data.refresh_descendants()
    end

    function esp:remove_object(Character)
        if not Character then return end
        local data = esp[Character.Name]
        if not data then return end
        for _, line in ipairs(data.drawings or {}) do pcall(function() line:Remove() end) end
        for _, c in ipairs(data.conns or {}) do pcall(function() c:Disconnect() end) end
        if data.objects and data.objects.holder then pcall(function() data.objects.holder:Destroy() end) end
        esp[Character.Name] = nil
    end

    function esp.refresh_elements()
        for _, data in pairs(esp) do
            if type(data) ~= 'table' or not data.objects then continue end
            local objects = data.objects
            local character = data.info.character
            if not character or not character.Parent then continue end
            objects.holder.Parent = esp_flags.Enabled and esp.screengui or esp.cache
            objects.name.Parent = esp_flags.Names and objects.holder or esp.cache
            objects.name.TextColor3 = esp_flags.Name_Color.Color
            local is_corner = esp_flags.Box_Type == 'Corner'
            if esp_flags.Boxes then
                objects.corners.Parent = (is_corner and objects.holder) or esp.cache
                objects.box_handler.Parent = (is_corner and esp.cache or objects.holder)
                objects.box_outline.Parent = (is_corner and esp.cache or objects.holder)
            else
                objects.corners.Parent = esp.cache
                objects.box_handler.Parent = esp.cache
                objects.box_outline.Parent = esp.cache
            end
            objects.box_color.Color = esp_flags.Box_Color.Color
            for _, corner in ipairs(objects.corners:GetChildren()) do
                local inner = corner:FindFirstChildOfClass('Frame')
                if inner then inner.BackgroundColor3 = esp_flags.Box_Color.Color end
            end
            for _, line in ipairs(data.drawings) do line.Color = esp_flags.Skeletons_Color.Color end
            objects.healthbar_holder.Parent = esp_flags.Healthbar and objects.holder or esp.cache
            objects.weapon.TextColor3 = esp_flags.Weapon_Color.Color
            objects.distance.TextColor3 = esp_flags.Distance_Color.Color
            objects.distance.Parent = esp_flags.Distance and objects.holder or esp.cache
        end
    end

    esp.connection = RunService.RenderStepped:Connect(function()
        if not esp_flags.Enabled then return end
        local seen = {}
        for _, Character in ipairs(Characters:GetChildren()) do
            seen[Character.Name] = true
            local data = esp[Character.Name]
            if data and data.info.character ~= Character then
                esp:remove_object(Character)
                data = nil
            end
            if not esp:isEnemy(Character) then
                if data then
                    if data.objects and data.objects.holder then
                        data.objects.holder.Visible = false
                    end
                    for _, line in ipairs(data.drawings) do line.Visible = false end
                end
                continue
            end
            if not data then
                esp:create_object(Character)
                data = esp[Character.Name]
                if not data then continue end
            end
            data.info.character = Character
            local objects = data.objects
            local holder = objects.holder
            local torso = Character:FindFirstChild('UpperTorso') or Character:FindFirstChild('Torso') or Character:FindFirstChild('HumanoidRootPart')
            if not torso then
                holder.Visible = false
                for _, line in ipairs(data.drawings) do line.Visible = false end
                continue
            end
            local box_size, box_pos, on_screen, distance = esp:box_solve(torso)
            if holder.Visible ~= on_screen then holder.Visible = on_screen end
            if esp_flags.Skeletons and on_screen then
                for i = 1, #boneList do
                    local line = data.drawings[i]
                    if line then
                        local a = Character:FindFirstChild(boneList[i][1])
                        local b = Character:FindFirstChild(boneList[i][2])
                        if a and b then
                            local o2, oOn = esp:get_screen_pos(a.Position)
                            local d2, dOn = esp:get_screen_pos(b.Position)
                            if oOn and dOn then
                                line.Visible = true
                                line.From = Vector2.new(o2.X, o2.Y)
                                line.To = Vector2.new(d2.X, d2.Y)
                            else
                                line.Visible = false
                            end
                        else
                            line.Visible = false
                        end
                    end
                end
            else
                for _, line in ipairs(data.drawings) do line.Visible = false end
            end
            if not on_screen or not box_size then continue end
            if holder.Position ~= dim_offset(box_pos.X, box_pos.Y) then
                holder.Position = dim_offset(box_pos.X, box_pos.Y)
            end
            if holder.Size ~= dim_offset(box_size.X, box_size.Y) then
                holder.Size = dim_offset(box_size.X, box_size.Y)
            end
            local distLabel = objects.distance
            local dText = tostring(math.round(distance)) .. 'st'
            if distLabel.Text ~= dText then distLabel.Text = dText end
        end
        for name, data in pairs(esp) do
            if type(data) == 'table' and data.objects and not seen[name] then
                esp:remove_object({ Name = name })
            end
        end
    end)

    Characters.ChildRemoved:Connect(function(Character)
        task.delay(0, function()
            if not Characters:FindFirstChild(Character.Name) then
                esp:remove_object(Character)
            end
        end)
    end)
end

local Win = Library:Window('spel.script', UDim2.fromOffset(620, 560))
local Combat = Win:AddTab('Combat')
local AimSec = Combat:AddSection('Aimbot', 'Left')
local AimbotToggle = AimSec:AddToggle('aimbot', false, function(on)
    State.Aimbot = on
    if not on then State.AimbotTarget = nil end
end)

