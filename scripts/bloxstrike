local CfgSec = Settings:AddSection('Configs', 'Right')
local CfgName = CfgSec:AddTextbox('Config name', '', 'Config name...')
local CfgList = CfgSec:AddList('Saved', Library:ListConfigs(), {
    Height = 96,
    Callback = function(v) if v and v ~= '' then CfgName:Set(v) end end,
})

local function CfgCurrent() return (CfgName:Get():gsub('^%s+', ''):gsub('%s+$', '')) end
local function CfgWrite(Name)
    if typeof(writefile) ~= 'function' then return end
    Library:EnsureConfigsFolder()
    local Json = Library:GetConfig()
    writefile(Library:ConfigPath(Name), (typeof(Json) == 'string') and Json or '{}')
    CfgList:Refresh(Library:ListConfigs())
end

CfgSec:AddButton('Create', function() local Name = CfgCurrent(); if Name == '' then return end; CfgWrite(Name) end)
    :AddButton('Save', function() local Name = CfgCurrent(); if Name == '' then return end; CfgWrite(Name) end)
CfgSec:AddButton('Load', function()
    local Name = CfgCurrent(); if Name == '' then return end
    if typeof(readfile) ~= 'function' then return end
    local Path = Library:ConfigPath(Name)
    if typeof(isfile) == 'function' and not isfile(Path) then return end
    local Data = readfile(Path)
    if typeof(Data) == 'string' then Library:LoadConfig(Data) end
end):AddButton('Delete', function()
    local Name = CfgCurrent(); if Name == '' then return end
    if typeof(delfile) ~= 'function' then return end
    local Path = Library:ConfigPath(Name)
    if typeof(isfile) == 'function' and not isfile(Path) then return end
    delfile(Path)
    CfgList:Refresh(Library:ListConfigs())
end)

local Watermark = Library:Watermark({ Segments = { 'spel.script', LocalPlayer.Name, '0 fps' } })
Library:KeybindList({ Title = 'Keybinds' })

task.spawn(function()
    local Acc, Frames = 0, 0
    while Watermark and Watermark.Gui and Watermark.Gui.Parent do
        local Dt = RunService.RenderStepped:Wait()
        Acc = Acc + Dt; Frames = Frames + 1
        if Acc >= 0.25 then
            Watermark:SetSegment(3, tostring(math.floor(Frames / Acc + 0.5)) .. ' fps')
            Acc = 0; Frames = 0
        end
    end
end)

task.spawn(function()
    task.wait(1)

    local ok, RemotesMod = pcall(function()
        return require(ReplicatedStorage.Database.Security.Remotes)
    end)

    if not ok or not RemotesMod then return end
    if not RemotesMod.Character or not RemotesMod.Character.CharacterDamaged then return end

    local activeDamageNumbers = {}

    local function createDamageNumber(worldPos, damage)
        local part = Instance.new('Part')
        part.Anchored = true
        part.CanCollide = false
        part.CanQuery = false
        part.CanTouch = false
        part.Transparency = 1
        part.Size = Vector3.new(0.1, 0.1, 0.1)
        part.CFrame = CFrame.new(worldPos)
        part.Name = 'DmgNumber'
        part.Parent = workspace

        local billboard = Instance.new('BillboardGui')
        billboard.Size = UDim2.fromOffset(140, 70)
        billboard.AlwaysOnTop = true
        billboard.LightInfluence = 0
        billboard.MaxDistance = math.huge
        billboard.Parent = part

        local label = Instance.new('TextLabel')
        label.BackgroundTransparency = 1
        label.Size = UDim2.fromScale(1, 1)
        label.Text = tostring(damage)
        label.TextColor3 = State.DamageNumberColor
        label.TextStrokeTransparency = 0
        label.TextStrokeColor3 = Color3.new(0, 0, 0)
        label.TextScaled = true
        label.FontFace = fonts.main
        label.Parent = billboard

        table.insert(activeDamageNumbers, {
            part = part,
            label = label,
            startPos = worldPos,
            startTime = tick(),
        })
    end

    RunService.RenderStepped:Connect(function()
        local now = tick()
        for i = #activeDamageNumbers, 1, -1 do
            local d = activeDamageNumbers[i]
            if not d.part.Parent then
                table.remove(activeDamageNumbers, i)
                continue
            end
            local age = now - d.startTime
            local progress = age / 1.0
            if progress >= 1 then
                d.part:Destroy()
                table.remove(activeDamageNumbers, i)
            else
                d.part.CFrame = CFrame.new(d.startPos + Vector3.new(0, progress * 6, 0))
                d.label.TextTransparency = progress
                d.label.TextStrokeTransparency = progress
            end
        end
    end)

    RemotesMod.Character.CharacterDamaged.Listen(function(payload)
        if not State.DamageNumbers then return end
        if not payload or not payload.VictimUserId then return end
        if payload.VictimUserId == LocalPlayer.UserId then return end
        local victim = Players:GetPlayerByUserId(payload.VictimUserId)
        if not victim then return end
        local char = victim.Character
        if not char then return end
        local head = char:FindFirstChild('Head') or char:FindFirstChild('UpperTorso')
        if not head then return end
        local damage = payload.Damage or payload.Amount or payload.dmg or payload.Value or 0
        if damage <= 0 then return end
        createDamageNumber(head.Position + Vector3.new(0, 2.5, 0), math.floor(damage + 0.5))
    end)
end)

return Library
