local Visuals = Win:AddTab('Visuals')
local EspTab = Visuals:AddSubTab('ESP')
local EspMain = EspTab:AddSection('Player ESP', 'Left')

local EspToggle = EspMain:AddToggle('enabled', false, function(on)
    esp_flags.Enabled = on
    if on then
        for _, Character in ipairs(Characters:GetChildren()) do
            if esp:isEnemy(Character) and not esp[Character.Name] then
                esp:create_object(Character)
            end
        end
    else
        for _, data in pairs(esp) do
            if type(data) == 'table' and data.objects and data.objects.holder then
                data.objects.holder.Visible = false
            end
            if type(data) == 'table' and data.drawings then
                for _, line in ipairs(data.drawings) do line.Visible = false end
            end
        end
    end
    esp.refresh_elements()
end)

