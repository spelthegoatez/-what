    ['minecraft ding'] = 'rbxassetid://135478009117226',
    ['minecraft'] = 'rbxassetid://103315511081890',
}
local MUSIC_IDS = {
    ['among us theme'] = 'rbxassetid://89816285393309',
    ['relaxed scene'] = 'rbxassetid://1848354536',
    ['menu theme'] = 'rbxassetid://114376757380093',
    ['super aura'] = 'rbxassetid://95131770144654',
}
local hitSoundTemplate = Instance.new('Sound')

hitSoundTemplate.Name = 'HitsoundTemplate'
hitSoundTemplate.SoundId = HITSOUND_IDS['cs:go']
hitSoundTemplate.Volume = 1
hitSoundTemplate.Parent = SoundService

local musicPlayer = Instance.new('Sound')

musicPlayer.Name = 'MusicPlayer'
musicPlayer.Volume = 1
musicPlayer.Looped = true
musicPlayer.Parent = SoundService

local function updateMusic()
    if State.MusicEnabled and State.MusicTrack then
        local id = MUSIC_IDS[State.MusicTrack]
        if id then
            if musicPlayer.SoundId ~= id then
                musicPlayer.SoundId = id
            end
            if not musicPlayer.Playing then
                musicPlayer:Play()
            end
            return
        end
    end
    if musicPlayer.Playing then
        musicPlayer:Stop()
    end
end

local function playHitsound()
    local id = HITSOUND_IDS[State.HitsoundPack]
    if not id then return end
    local s = hitSoundTemplate:Clone()
    s.SoundId = id
    s.Parent = SoundService
    s:Play()
    task.delay(3, function() if s then s:Destroy() end end)
end

local TRACER_LIFETIME = 1.5
local activeTracers = {}

local function createTracer(fromPos, toPos)
    if not State.Tracers then return end

    local ok, line = pcall(function() return Drawing.new('Line') end)
    if not ok or not line then return end

    line.Visible = true
    line.Color = State.TracerColor
    line.Thickness = 1.5
    line.Transparency = 0
    line.ZIndex = 9999
    line.From = Vector2.new(0, 0)
    line.To = Vector2.new(0, 0)

    table.insert(activeTracers, {
        line = line,
        from = fromPos,
        to = toPos,
        startTime = tick(),
    })
end

RunService.RenderStepped:Connect(function()
    local now = tick()
    local cam = workspace.CurrentCamera

    for i = #activeTracers, 1, -1 do
        local t = activeTracers[i]
        local age = now - t.startTime
        local progress = age / TRACER_LIFETIME

        if progress >= 1 then
            pcall(function() t.line:Remove() end)
            table.remove(activeTracers, i)
        else
            local alpha = 1 - progress
            local fromScreen, fromOn = cam:WorldToViewportPoint(t.from)
            local toScreen, toOn = cam:WorldToViewportPoint(t.to)

            if fromOn and toOn and fromScreen.Z > 0 and toScreen.Z > 0 then
                t.line.Visible = true
                t.line.From = Vector2.new(fromScreen.X, fromScreen.Y)
                t.line.To = Vector2.new(toScreen.X, toScreen.Y)
                t.line.Color = State.TracerColor
                t.line.Transparency = 1 - alpha
            else
                t.line.Visible = false
            end
        end
    end
end)

local function partIsEnemy(inst)
    if not inst then return false end
    local model = inst:FindFirstAncestorOfClass('Model')
    if not model or not model:IsDescendantOf(Characters) then return false end
    if model.Name == LocalPlayer.Name then return false end
    local plr = Players:FindFirstChild(model.Name)
    if not plr then return false end
    if plr:GetAttribute('Team') == LocalPlayer:GetAttribute('Team') then return false end
    if model:GetAttribute('Dead') == true then return false end
    if (model:GetAttribute('Health') or 0) <= 0 then return false end
    return true
end

local HIT_SOUND_KEYS = {
    hit = true, hitsound = true, ['hit sound'] = true, hitmarker = true,
    ['hit marker'] = true, hit_flesh = true, ['hit flesh'] = true,
    ['flesh hit'] = true, flesh = true, ['flesh impact'] = true,
    ['impact flesh'] = true, ['body hit'] = true, ['headshot hit'] = true,
    ['armor hit'] = true, ['helmet hit'] = true,
}

local function isGameHitSound(name)
    if not name then return false end
    local lower = string.lower(tostring(name))
    if HIT_SOUND_KEYS[lower] then return true end
    if string.find(lower, 'hitmarker', 1, true) then return true end
    if string.find(lower, 'hit sound', 1, true) then return true end
    if string.find(lower, 'hit_sound', 1, true) then return true end
    if string.find(lower, 'hit marker', 1, true) then return true end
    return false
end

local function muteIfHitSound(result)
    if not result then return end
    if typeof(result) == 'Instance' and result:IsA('Sound') then
        pcall(function() result.Volume = 0 end)
    end
end

pcall(function()
    local SoundClass = require(ReplicatedStorage.Classes.Sound)
    if type(SoundClass) ~= 'table' or type(SoundClass.new) ~= 'function' then return end
    local OldSoundNew = SoundClass.new
    SoundClass.new = function(...)
        local inst = OldSoundNew(...)
        if type(inst) == 'table' and not inst.__hitpatched then
            pcall(function() inst.__hitpatched = true end)
            for _, methodName in ipairs({ 'play', 'playOneTime', 'PlaySoundAtPosition' }) do
                local orig = inst[methodName]
                if type(orig) == 'function' then
                    pcall(function()
                        inst[methodName] = function(self, info, ...)
                            local result = orig(self, info, ...)
                            if State.RemoveGameHit and type(info) == 'table' and isGameHitSound(info.Name) then
                                muteIfHitSound(result)
                                if result then
                                    task.defer(function()
                                        if result and result.Parent then muteIfHitSound(result) end
                                    end)
                                end
                            end
                            return result
                        end
                    end)
                end
            end
        end
        return inst
    end
end)

local spinAngleDeg = 0

local function getLocalRoot()
    local char = LocalPlayer.Character
    if char and char.Parent then
        local root = char.PrimaryPart or char:FindFirstChild('HumanoidRootPart') or char:FindFirstChild('UpperTorso') or char:FindFirstChild('Torso')
        if root then return root end
    end
    if Characters then
        local charModel = Characters:FindFirstChild(LocalPlayer.Name)
        if charModel and charModel.Parent then
            local root = charModel.PrimaryPart or charModel:FindFirstChild('HumanoidRootPart') or charModel:FindFirstChild('UpperTorso') or charModel:FindFirstChild('Torso')
            if root then return root end
        end
    end
    return nil
end

RunService:BindToRenderStep('AntiAimSpinbotOverride', 9999, function(dt)
    if not State.Spinbot then return end
    local root = getLocalRoot()
    if not root then return end
    spinAngleDeg = (spinAngleDeg + State.SpinbotSpeed * dt) % 360
    local pos = root.CFrame.Position
    root.CFrame = CFrame.new(pos) * CFrame.Angles(0, math.rad(spinAngleDeg), 0)
end)

if type(CameraController) == 'table' then
    local oldSetEnabled = CameraController.SetEnabled or CameraController.setEnabled
    if oldSetEnabled then
        CameraController.SetEnabled = function(enabled)
            if State.ThirdPerson then return oldSetEnabled(false) end
            return oldSetEnabled(enabled)
        end
        CameraController.setEnabled = CameraController.SetEnabled
    end
end

pcall(function()
    local oldNewIndex
    oldNewIndex = hookmetamethod(game, '__newindex', function(self, key, value)
        if not checkcaller() and State.ThirdPerson then
            if self == LocalPlayer then
                if key == 'CameraMode' then return oldNewIndex(self, key, Enum.CameraMode.Classic)
                elseif key == 'CameraMaxZoomDistance' then return oldNewIndex(self, key, 12)
                elseif key == 'CameraMinZoomDistance' then return oldNewIndex(self, key, 4) end
            elseif self == Camera then
                if key == 'CameraType' then return oldNewIndex(self, key, Enum.CameraType.Custom)
                elseif key == 'CameraSubject' then
                    local char = LocalPlayer.Character or Characters:FindFirstChild(LocalPlayer.Name)
                    local hum = char and char:FindFirstChildOfClass('Humanoid')
                    if hum then return oldNewIndex(self, key, hum) end
                end
            end
        end
        return oldNewIndex(self, key, value)
    end)
end)

RunService:BindToRenderStep('ForceThirdPersonState', Enum.RenderPriority.Camera.Value + 100, function()
    if not State.ThirdPerson then return end
    pcall(function() CameraController.SetEnabled(false) end)
    if Camera.CameraType ~= Enum.CameraType.Custom then Camera.CameraType = Enum.CameraType.Custom end
    if LocalPlayer.CameraMode ~= Enum.CameraMode.Classic then LocalPlayer.CameraMode = Enum.CameraMode.Classic end
    if LocalPlayer.CameraMaxZoomDistance ~= 12 then LocalPlayer.CameraMaxZoomDistance = 12 end
    if LocalPlayer.CameraMinZoomDistance ~= 4 then LocalPlayer.CameraMinZoomDistance = 4 end
    local char = LocalPlayer.Character or Characters:FindFirstChild(LocalPlayer.Name)
    if char then
        local hum = char:FindFirstChildOfClass('Humanoid')
        if hum and Camera.CameraSubject ~= hum then Camera.CameraSubject = hum end
    end
end)

local function applyThirdPerson(on)
    if on then
        pcall(function() CameraController.SetEnabled(false) end)
        Camera.CameraType = Enum.CameraType.Custom
        LocalPlayer.CameraMode = Enum.CameraMode.Classic
        LocalPlayer.CameraMaxZoomDistance = 12
        LocalPlayer.CameraMinZoomDistance = 4
        local char = LocalPlayer.Character or Characters:FindFirstChild(LocalPlayer.Name)
        if char then
            local hum = char:FindFirstChildOfClass('Humanoid')
            if hum then Camera.CameraSubject = hum end
        end
    else
        pcall(function() CameraController.SetEnabled(true) end)
        LocalPlayer.CameraMode = Enum.CameraMode.LockFirstPerson
        LocalPlayer.CameraMaxZoomDistance = 0
        LocalPlayer.CameraMinZoomDistance = 0
        local char = LocalPlayer.Character or Characters:FindFirstChild(LocalPlayer.Name)
        if char then
            local camPart = char:FindFirstChild('CameraPart')
            local hum = char:FindFirstChildOfClass('Humanoid')
            Camera.CameraType = Enum.CameraType.Custom
            if camPart then Camera.CameraSubject = camPart elseif hum then Camera.CameraSubject = hum end
        end
    end
end

LocalPlayer.CharacterAdded:Connect(function()
    if State.ThirdPerson then
        task.defer(function() task.wait(0.25); applyThirdPerson(true) end)
    end
end)

