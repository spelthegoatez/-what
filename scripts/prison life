local HttpService = game:GetService('HttpService')
local Debris = game:GetService('Debris')
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera
local FIRE_RATE = 0.03
local TARGET_TEAM_NAME = 'Criminals'
local FLY_SPEED = 100
local ORBIT_SPEED = 6
local ORBIT_RADIUS = 12
local ORBIT_LERP = 0.5
local TRACER_FADE_IN = 0.5
local TRACER_HOLD = 2
local TRACER_FADE_OUT = 0.5
local HITSOUND_ID = 'rbxassetid://133002449941130'
local HITSOUND_VOLUME = 1.5
local HIT_WINDOW = 0.5
local DMG_NUMBER_COLOR = Color3.fromRGB(255, 255, 0)
local DMG_DURATION = 1
local DMG_RISE_SPEED = 6
local rageEnabled = false
local flyEnabled = false
local orbitEnabled = false
local tracersEnabled = false
local hitsoundEnabled = false
local dmgNumbersEnabled = false
local rapidFireEnabled = false
local rapidFirePercent = 100
local noRecoilEnabled = false
local noSpreadEnabled = false
local silentAimEnabled = false
local silentAimFOVVisible = true
local silentAimFOVRadius = 120
local GunRemotes = ReplicatedStorage:WaitForChild('GunRemotes', 10)
local ShootEvent = GunRemotes and GunRemotes:WaitForChild('ShootEvent', 10)
local FuncReload = GunRemotes and GunRemotes:WaitForChild('FuncReload', 10)
local Remotes = ReplicatedStorage:WaitForChild('Remotes', 10)
local GiverPressed = Remotes and Remotes:WaitForChild('GiverPressed', 10)
local BulletsLabel = nil

local function getEffectiveFireRate()
    if not rapidFireEnabled then return FIRE_RATE end
    return 0.001 + (FIRE_RATE - 0.001) * (rapidFirePercent / 100)
end

task.spawn(function()
    local PlayerGui = LocalPlayer:WaitForChild('PlayerGui')
    local HomeGui = PlayerGui:WaitForChild('Home', 15)
    if not HomeGui then return end
    local hud = HomeGui:WaitForChild('hud', 15)
    if not hud then return end
    local GunFrame = hud:WaitForChild('BottomRightFrame', 15)
    if not GunFrame then return end
    GunFrame = GunFrame:WaitForChild('GunFrame', 15)
    if not GunFrame then return end
    BulletsLabel = GunFrame:WaitForChild('BulletsLabel', 15)
end)

local unpack = table.unpack or unpack
local Fonts

do
    local HttpSvc = cloneref and cloneref(HttpService) or HttpService
    Fonts = {
        Folder = 'CustomFonts',
        verdana = {
            FileName = {'verdana.ttf', 'verdana.json'},
            Url = 'https://github.com/sametexe001/luas/raw/refs/heads/main/fonts/verdana.ttf',
        },
    }
    if not isfolder(Fonts.Folder) then makefolder(Fonts.Folder) end
    for Name, FontData in pairs(Fonts) do
        if type(FontData) == 'table' then
            local FileName = FontData.FileName
            if not isfile(Fonts.Folder .. '/' .. FileName[1]) then
                writefile(Fonts.Folder .. '/' .. FileName[1], game:HttpGet(FontData.Url))
            end
            local Data = {
                Name = Name,
                Faces = {{Name = 'Regular', Weight = 200, Style = 'Regular', AssetId = getcustomasset(Fonts.Folder .. '/' .. FileName[1])}},
            }
            if not isfile(Fonts.Folder .. '/' .. FileName[2]) then
                writefile(Fonts.Folder .. '/' .. FileName[2], HttpSvc:JSONEncode(Data))
            end
        end
    end
    function Fonts.GetFont(Name)
        for FontName, FontData in pairs(Fonts) do
            if FontName == Name then
                return Font.new(getcustomasset(Fonts.Folder .. '/' .. FontData.FileName[2]))
            end
        end
    end
end

local verdanaFont = Fonts.GetFont('verdana')

local function isSameTeam(player)
    if LocalPlayer.Team == nil or player.Team == nil then return false end
    return LocalPlayer.Team == player.Team
end

local function isVisibleFromCamera(targetPart)
    local character = LocalPlayer.Character
    if not character then return false end
    local origin = Camera.CFrame.Position
    local direction = targetPart.Position - origin
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = {character, Camera}
    rp.IgnoreWater = true
    local result = workspace:Raycast(origin, direction, rp)
    if result then return result.Instance:IsDescendantOf(targetPart.Parent) end
    return true
end

local function hasLineOfSight(targetPart)
    local character = LocalPlayer.Character
    if not character then return false end
    local head = character:FindFirstChild('Head')
    if not head then return false end
    local origin = head.Position
    local direction = targetPart.Position - origin
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = {character, Camera}
    rp.IgnoreWater = true
    local result = workspace:Raycast(origin, direction, rp)
    if result then return result.Instance:IsDescendantOf(targetPart.Parent) end
    return true
end

local function isCriminal(player)
    if not player then return false end
    local team = player.Team
    if not team then return end
    return team.Name == TARGET_TEAM_NAME
end

local function isInVehicle(humanoid)
    if not humanoid then return false end
    return humanoid.SeatPart ~= nil
end

task.spawn(function()
    while task.wait(0.1) do
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass('Humanoid')
        if hum then
            pcall(function() hum.Sit = false end)
            if hum.SeatPart then
                pcall(function()
                    hum.Sit = false
                    hum.SeatPart = nil
                    hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                end)
            end
        end
    end
end)

task.spawn(function()
    local function hookSeat(seat)
        if not seat:IsA('Seat') then return end
        seat:GetPropertyChangedSignal('Occupant'):Connect(function()
            if seat.Occupant then
                local char = LocalPlayer.Character
                local hum = char and char:FindFirstChildOfClass('Humanoid')
                if hum and seat.Occupant == hum then
                    pcall(function()
                        hum.Sit = false
                        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                    end)
                end
            end
        end)
    end
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA('Seat') then hookSeat(v) end
    end
    workspace.DescendantAdded:Connect(function(v)
        if v:IsA('Seat') then hookSeat(v) end
    end)
end)

local closestHitPart = nil
local lockedTarget = nil
local cursorPosition = Vector2.new(0, 0)

local function updateCursor(input)
    if input and input.Position then
        cursorPosition = Vector2.new(input.Position.X, input.Position.Y)
    end
end

UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        updateCursor(input)
    end
end)

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.MouseButton1 then
        updateCursor(input)
    end
end)

local function getSilentAimTarget()
    local closestPart, closestDist = nil, math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and not isSameTeam(player) then
            local head = player.Character:FindFirstChild('Head')
            local hum = player.Character:FindFirstChild('Humanoid')
            if head and hum and hum.Health > 0 then
                local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen and screenPos.Z > 0 then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - cursorPosition).Magnitude
                    if dist < silentAimFOVRadius and dist < closestDist then
                        closestDist = dist
                        closestPart = head
                    end
                end
            end
        end
    end
    return closestPart
end

local function getClosestEnemy()
    local closestPart, closestDistance = nil, math.huge
    local myPos = Camera.CFrame.Position
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and not isSameTeam(player) then
            local hrp = player.Character:FindFirstChild('HumanoidRootPart')
            local hum = player.Character:FindFirstChild('Humanoid')
            if hrp and hum and hum.Health > 0 then
                local distance = (hrp.Position - myPos).Magnitude
                if distance < closestDistance and isVisibleFromCamera(hrp) then
                    closestDistance = distance
                    closestPart = hrp
                end
            end
        end
    end
    return closestPart
end

local function getClosestCriminalNoWall()
    local closestPart, closestDistance = nil, math.huge
    local myPos = Camera.CFrame.Position
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and not isSameTeam(player) and isCriminal(player) then
            local hrp = player.Character:FindFirstChild('HumanoidRootPart')
            local hum = player.Character:FindFirstChild('Humanoid')
            if hrp and hum and hum.Health > 0 then
                local distance = (hrp.Position - myPos).Magnitude
                if distance < closestDistance then
                    closestDistance = distance
                    closestPart = hrp
                end
            end
        end
    end
    return closestPart
end

local function getLockedTarget()
    if lockedTarget and lockedTarget.Parent then
        local hum = lockedTarget.Parent:FindFirstChildOfClass('Humanoid')
        if hum and hum.Health > 0 then return lockedTarget end
    end
    lockedTarget = getClosestCriminalNoWall()
    return lockedTarget
end

RunService.Heartbeat:Connect(function()
    closestHitPart = getClosestEnemy()
end)

local RECOIL_ATTRS = {
    'Recoil', 'RecoilAmount', 'RecoilMultiplier', 'RecoilScale',
    'CameraRecoil', 'WeaponRecoil', 'GunRecoil', 'VerticalRecoil',
    'HorizontalRecoil', 'RecoilKick', 'Kickback',
}

local Originals = {
    toolAttrs = setmetatable({}, {__mode = 'k'}),
}

local function applyNoRecoil(tool)
    if not tool then return end
    if not Originals.toolAttrs[tool] then
        local saved = {}
        for _, name in ipairs(RECOIL_ATTRS) do
            local v = tool:GetAttribute(name)
            if v ~= nil then saved[name] = v end
        end
        Originals.toolAttrs[tool] = saved
    end
    if noRecoilEnabled then
        for _, name in ipairs(RECOIL_ATTRS) do
            pcall(function() tool:SetAttribute(name, 0) end)
        end
    else
        local saved = Originals.toolAttrs[tool]
        if saved then
            for name, v in pairs(saved) do
                pcall(function() tool:SetAttribute(name, v) end)
            end
        end
    end
end

local function patchTool(tool)
    if typeof(tool) ~= 'Instance' or not tool:IsA('Tool') then return end
    if tool:GetAttribute('ToolType') ~= 'Gun' then return end

    if rapidFireEnabled then
        tool:SetAttribute('FireRate', getEffectiveFireRate())
        tool:SetAttribute('AutoFire', true)
    end

    if noSpreadEnabled then
        tool:SetAttribute('SpreadRadius', 0)
    end

    applyNoRecoil(tool)
end

local function reapplyAllTools()
    local bp = LocalPlayer:FindFirstChild('Backpack')
    if bp then
        for _, v in ipairs(bp:GetChildren()) do
            if v:IsA('Tool') then patchTool(v) end
        end
    end
    local char = LocalPlayer.Character
    if char then
        for _, v in ipairs(char:GetChildren()) do
            if v:IsA('Tool') then patchTool(v) end
        end
    end
end

local function watch(container)
    if not container then return end
    for _, v in ipairs(container:GetChildren()) do
        if v:IsA('Tool') then patchTool(v) end
    end
    container.ChildAdded:Connect(function(v)
        if v:IsA('Tool') then patchTool(v) end
    end)
end

if LocalPlayer:FindFirstChild('Backpack') then watch(LocalPlayer.Backpack) end
if LocalPlayer.Character then watch(LocalPlayer.Character) end
LocalPlayer.ChildAdded:Connect(function(c)
    if c.Name == 'Backpack' then watch(c) end
end)
LocalPlayer.CharacterAdded:Connect(function(char)
    watch(char)
    local bp = LocalPlayer:FindFirstChild('Backpack')
    if bp then watch(bp) end
end)

local activeTracers = {}

local function createTracer(fromPos, toPos)
    if not tracersEnabled then return end
    local line = Drawing.new('Line')
    line.Visible = false
    line.Color = Color3.new(1, 1, 1)
    line.Thickness = 1.5
    line.Transparency = 0
    line.ZIndex = 9999
    table.insert(activeTracers, {
        line = line,
        from = fromPos,
        to = toPos,
        startTime = tick(),
    })
end

RunService.RenderStepped:Connect(function()
    local now = tick()
    for i = #activeTracers, 1, -1 do
        local t = activeTracers[i]
        local age = now - t.startTime
        local total = TRACER_FADE_IN + TRACER_HOLD + TRACER_FADE_OUT
        if age >= total then
            t.line:Remove()
            table.remove(activeTracers, i)
        else
            local alpha
            if age < TRACER_FADE_IN then alpha = age / TRACER_FADE_IN
            elseif age < TRACER_FADE_IN + TRACER_HOLD then alpha = 1
            else alpha = 1 - ((age - TRACER_FADE_IN - TRACER_HOLD) / TRACER_FADE_OUT) end
            local fromScreen, fromOn = Camera:WorldToViewportPoint(t.from)
            local toScreen, toOn = Camera:WorldToViewportPoint(t.to)
            if fromOn and toOn and fromScreen.Z > 0 and toScreen.Z > 0 then
                t.line.Visible = true
                t.line.From = Vector2.new(fromScreen.X, fromScreen.Y)
                t.line.To = Vector2.new(toScreen.X, toScreen.Y)
                t.line.Transparency = 1 - math.clamp(alpha, 0, 1)
            else
                t.line.Visible = false
            end
        end
    end
end)

local activeWatchers = {}

local function playHitSound()
    if not hitsoundEnabled then return end
    local s = Instance.new('Sound')
    s.SoundId = HITSOUND_ID
    s.Volume = HITSOUND_VOLUME
    s.Parent = SoundService
    s:Play()
    Debris:AddItem(s, 2)
end

local function createDamageNumber(worldPos, damage)
    if not dmgNumbersEnabled then return end
    local part = Instance.new('Part')
    part.Anchored = true
    part.CanCollide = false
    part.CanQuery = false
    part.CanTouch = false
    part.Transparency = 1
    part.Size = Vector3.new(0.1, 0.1, 0.1)
    part.CFrame = CFrame.new(worldPos)
    part.Name = 'DmgNumber'
    part.Parent = workspace
    local billboard = Instance.new('BillboardGui')
    billboard.Size = UDim2.fromOffset(140, 70)
    billboard.AlwaysOnTop = true
    billboard.LightInfluence = 0
    billboard.Parent = part
    local label = Instance.new('TextLabel')
    label.BackgroundTransparency = 1
    label.Size = UDim2.fromScale(1, 1)
    label.Text = tostring(damage)
    label.TextColor3 = DMG_NUMBER_COLOR
    label.TextStrokeTransparency = 0
    label.TextStrokeColor3 = Color3.new(0, 0, 0)
    label.TextScaled = true
    label.FontFace = verdanaFont
    label.Parent = billboard
    task.spawn(function()
        local startTime = tick()
        while part.Parent do
            local age = tick() - startTime
            local progress = age / DMG_DURATION
            if progress >= 1 then break end
            part.CFrame = CFrame.new(worldPos + Vector3.new(0, progress * DMG_RISE_SPEED, 0))
            label.TextTransparency = progress
            label.TextStrokeTransparency = progress
            RunService.RenderStepped:Wait()
        end
        part:Destroy()
    end)
end

local function watchForHit(humanoid)
    if not humanoid then return end
    if activeWatchers[humanoid] then return end
    local lastHealth = humanoid.Health
    local startTime = tick()
    local conn
    conn = humanoid.HealthChanged:Connect(function(newHealth)
        local dmg = lastHealth - newHealth
        lastHealth = newHealth
        if dmg > 0 then
            playHitSound()
            local char = humanoid.Parent
            local head = char and char:FindFirstChild('Head')
            if head then
                createDamageNumber(head.Position + Vector3.new(0, 2.5, 0), math.floor(dmg + 0.5))
            end
        end
        if tick() - startTime > HIT_WINDOW then
            if activeWatchers[humanoid] == conn then
                conn:Disconnect()
                activeWatchers[humanoid] = nil
            end
        end
    end)
    activeWatchers[humanoid] = conn
    task.delay(HIT_WINDOW + 0.1, function()
        if activeWatchers[humanoid] == conn then
            conn:Disconnect()
            activeWatchers[humanoid] = nil
        end
    end)
end

local flyBV, flyBG
local heldKeys = {}

local function setupFly(character)
    local hrp = character:WaitForChild('HumanoidRootPart', 5)
    if not hrp then return end
    if flyBV then flyBV:Destroy() end
    if flyBG then flyBG:Destroy() end
    flyBV = Instance.new('BodyVelocity')
    flyBV.Name = 'FlyBV'
    flyBV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    flyBV.Velocity = Vector3.zero
    flyBV.P = 1250
    flyBV.Parent = hrp
    flyBG = Instance.new('BodyGyro')
    flyBG.Name = 'FlyBG'
    flyBG.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    flyBG.P = 10000
    flyBG.D = 100
    flyBG.CFrame = hrp.CFrame
    flyBG.Parent = hrp
    flyBV.MaxForce = Vector3.zero
    flyBG.MaxTorque = Vector3.zero
end

if LocalPlayer.Character then task.spawn(setupFly, LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(function(char) task.spawn(setupFly, char) end)

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    heldKeys[input.KeyCode] = true
end)
UserInputService.InputEnded:Connect(function(input)
    heldKeys[input.KeyCode] = false
end)

local function setFlyActive(active)
    if not flyBV or not flyBV.Parent or not flyBG or not flyBG.Parent then return end
    if active then
        flyBV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        flyBG.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    else
        flyBV.MaxForce = Vector3.zero
        flyBG.MaxTorque = Vector3.zero
        flyBV.Velocity = Vector3.zero
    end
end

RunService.RenderStepped:Connect(function()
    if _G.AutoGrabLock then return end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild('HumanoidRootPart')
    if not hrp or not flyBV or not flyBV.Parent or not flyBG or not flyBG.Parent then return end
    if orbitEnabled then
        setFlyActive(true)
        local target = getLockedTarget()
        if target and target.Parent then
            local targetHum = target.Parent:FindFirstChildOfClass('Humanoid')
            local targetPos = target.Position
            local lookCFrame
            if isInVehicle(targetHum) then
                lookCFrame = CFrame.new(targetPos) * (target.CFrame - target.Position)
            else
                local angle = tick() * ORBIT_SPEED
                local yOffset = 0
                if heldKeys[Enum.KeyCode.Space] then yOffset = yOffset + 10 end
                if heldKeys[Enum.KeyCode.LeftControl] then yOffset = yOffset - 10 end
                local orbitPos = targetPos + Vector3.new(math.cos(angle) * ORBIT_RADIUS, yOffset, math.sin(angle) * ORBIT_RADIUS)
                lookCFrame = CFrame.new(orbitPos, targetPos)
            end
            local newCFrame = hrp.CFrame:Lerp(lookCFrame, ORBIT_LERP)
            hrp.CFrame = newCFrame
            flyBV.Velocity = Vector3.zero
            flyBG.CFrame = newCFrame
        else
            flyBV.Velocity = Vector3.zero
            flyBG.CFrame = hrp.CFrame
        end
        return
    end
    if not flyEnabled then
        setFlyActive(false)
        return
    end
    setFlyActive(true)
    local cam = workspace.CurrentCamera.CFrame
    local moveDir = Vector3.zero
    if heldKeys[Enum.KeyCode.W] then moveDir = moveDir + cam.LookVector end
    if heldKeys[Enum.KeyCode.S] then moveDir = moveDir - cam.LookVector end
    if heldKeys[Enum.KeyCode.A] then moveDir = moveDir - cam.RightVector end
    if heldKeys[Enum.KeyCode.D] then moveDir = moveDir + cam.RightVector end
    if heldKeys[Enum.KeyCode.Space] then moveDir = moveDir + Vector3.new(0, 1, 0) end
    if heldKeys[Enum.KeyCode.LeftControl] then moveDir = moveDir - Vector3.new(0, 1, 0) end
    if moveDir.Magnitude > 0 then moveDir = moveDir.Unit * FLY_SPEED end
    flyBV.Velocity = moveDir
    flyBG.CFrame = CFrame.new(hrp.Position, hrp.Position + cam.LookVector)
end)

