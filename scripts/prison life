local CfgSec = Settings:AddSection('configs', 'Right')
local CfgName = CfgSec:AddTextbox('config name', '', 'config name...')
local CfgList = CfgSec:AddList('saved', Library:ListConfigs(), {
    Height = 96,
    Callback = function(v)
        if v and v ~= '' then CfgName:Set(v) end
    end,
})

local function CfgCurrent()
    return (CfgName:Get():gsub('^%s+', ''):gsub('%s+$', ''))
end

local function CfgWrite(Name)
    if typeof(writefile) ~= 'function' then return end
    Library:EnsureConfigsFolder()
    local Json = Library:GetConfig()
    writefile(Library:ConfigPath(Name), (typeof(Json) == 'string') and Json or '{}')
    CfgList:Refresh(Library:ListConfigs())
end

CfgSec:AddButton('create', function()
    local Name = CfgCurrent()
    if Name == '' then return end
    CfgWrite(Name)
end):AddButton('save', function()
    local Name = CfgCurrent()
    if Name == '' then return end
    CfgWrite(Name)
end)

CfgSec:AddButton('load', function()
    local Name = CfgCurrent()
    if Name == '' then return end
    if typeof(readfile) ~= 'function' then return end
    local Path = Library:ConfigPath(Name)
    if typeof(isfile) == 'function' and not isfile(Path) then return end
    local Data = readfile(Path)
    if typeof(Data) == 'string' then Library:LoadConfig(Data) end
end):AddButton('delete', function()
    local Name = CfgCurrent()
    if Name == '' then return end
    if typeof(delfile) ~= 'function' then return end
    local Path = Library:ConfigPath(Name)
    if typeof(isfile) == 'function' and not isfile(Path) then return end
    delfile(Path)
    CfgList:Refresh(Library:ListConfigs())
end)

local Watermark = Library:Watermark({
    Segments = {'spel.script', LocalPlayer.Name, '0 fps'},
})

Library:KeybindList({Title = 'keybinds'})

task.spawn(function()
    local Acc, Frames = 0, 0
    while Watermark and Watermark.Gui and Watermark.Gui.Parent do
        local Dt = RunService.RenderStepped:Wait()
        Acc = Acc + Dt
        Frames = Frames + 1
        if Acc >= 0.25 then
            Watermark:SetSegment(3, tostring(math.floor(Frames / Acc + 0.5)) .. ' fps')
            Acc = 0
            Frames = 0
        end
    end
end)

local function getEquippedGun()
    local character = LocalPlayer.Character
    if not character then return nil end
    local tool = character:FindFirstChildOfClass('Tool')
    if tool and tool:GetAttribute('ToolType') == 'Gun' then
        return tool
    end
    return nil
end

local function getMuzzlePosition(tool)
    if not tool then
        local char = LocalPlayer.Character
        local head = char and char:FindFirstChild('Head')
        return head and head.Position or Camera.CFrame.Position
    end
    local muzzle = tool:FindFirstChild('Muzzle', true)
    if muzzle then
        if muzzle:IsA('BasePart') then return muzzle.Position
        elseif muzzle:IsA('Attachment') then return muzzle.WorldPosition end
    end
    local handle = tool:FindFirstChild('Handle')
    if handle and handle:IsA('BasePart') then return handle.Position end
    local char = LocalPlayer.Character
    local head = char and char:FindFirstChild('Head')
    return head and head.Position or Camera.CFrame.Position
end

local function updateAmmoLabel(tool)
    if not BulletsLabel then return end
    local ammo = tool:GetAttribute('Local_CurrentAmmo') or 0
    local maxAmmo = tool:GetAttribute('MaxAmmo') or 0
    local behavior = tool:GetAttribute('Behavior')
    if behavior == 'Sniper' then
        local stored = tool:GetAttribute('StoredAmmo') or 0
        BulletsLabel.Text = ammo .. ' | ' .. stored
    else
        BulletsLabel.Text = ammo .. '/' .. maxAmmo
    end
end

local function autoReload(tool)
    if not tool or not FuncReload then return end
    if tool:GetAttribute('Local_ReloadSession') > 0 then return end
    local reloadTime = tool:GetAttribute('ReloadTime') or 1
    local maxAmmo = tool:GetAttribute('MaxAmmo') or 0
    local behavior = tool:GetAttribute('Behavior')
    local session = tick()
    tool:SetAttribute('Local_ReloadSession', session)
    if BulletsLabel then BulletsLabel.Text = '...' end
    pcall(function() FuncReload:InvokeServer() end)
    task.wait(reloadTime)
    if tool.Parent and tool:GetAttribute('Local_ReloadSession') == session then
        if behavior == 'Sniper' then
            local stored = tool:GetAttribute('StoredAmmo') or 0
            if stored > 0 then
                tool:SetAttribute('Local_CurrentAmmo', 1)
                tool:SetAttribute('StoredAmmo', stored - 1)
            else
                tool:SetAttribute('Local_CurrentAmmo', 0)
            end
        else
            tool:SetAttribute('Local_CurrentAmmo', maxAmmo)
        end
        updateAmmoLabel(tool)
        tool:SetAttribute('Local_ReloadSession', 0)
    end
end

task.spawn(function()
    local reloading = false
    while true do
        task.wait(getEffectiveFireRate())
        if not rageEnabled then continue end
        local target = getLockedTarget()
        local tool = getEquippedGun()
        if tool and target and target.Parent then
            local ammo = tool:GetAttribute('Local_CurrentAmmo') or 0
            local session = tool:GetAttribute('Local_ReloadSession') or 0
            if hasLineOfSight(target) then
                if ammo <= 0 and session == 0 and not reloading then
                    reloading = true
                    task.spawn(function()
                        autoReload(tool)
                        reloading = false
                    end)
                end
                if ammo > 0 and session == 0 then
                    local character = LocalPlayer.Character
                    local head = character and character:FindFirstChild('Head')
                    if head and ShootEvent then
                        local origin = head.Position
                        local packet = {{origin, target.Position, target}}
                        local muzzlePos = getMuzzlePosition(tool)
                        createTracer(muzzlePos, target.Position)
                        pcall(function() ShootEvent:FireServer(packet) end)
                        local tHum = target.Parent:FindFirstChildOfClass('Humanoid')
                        if tHum then watchForHit(tHum) end
                        local newAmmo = ammo - 1
                        tool:SetAttribute('Local_CurrentAmmo', newAmmo)
                        updateAmmoLabel(tool)
                    end
                end
            end
        end
    end
end)

_G.AutoGrabLock = false

local function findTouchGiver()
    local ok, target = pcall(function() return workspace:GetChildren()[187] end)
    if not ok or not target then return nil, nil end
    local tg = target:FindFirstChild('TouchGiver')
    if tg and tg:IsA('BasePart') then return tg, target end
    if target:IsA('BasePart') then return target, target end
    return nil, target
end

local function autoGrabWeapon()
    local char = LocalPlayer.Character
    local hrp = char and char:WaitForChild('HumanoidRootPart', 5)
    if not hrp then return end
    local touchGiver, giverParent = findTouchGiver()
    if not touchGiver then return end
    _G.AutoGrabLock = true
    if flyBV then flyBV.Velocity = Vector3.zero end
    if flyBG then flyBG.CFrame = CFrame.new(hrp.Position) end
    local savedCFrame = hrp.CFrame
    hrp.CFrame = CFrame.new(touchGiver.Position + Vector3.new(0, 1.5, 0))
    task.wait(0.35)
    if GiverPressed and giverParent then
        pcall(function() GiverPressed:FireServer(giverParent) end)
    end
    task.wait(0.25)
    if hrp.Parent then hrp.CFrame = savedCFrame end
    _G.AutoGrabLock = false
end

LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(0.8)
    task.spawn(autoGrabWeapon)
end)

if LocalPlayer.Character then task.spawn(autoGrabWeapon) end

local oldNamecall
oldNamecall = hookmetamethod(game, '__namecall', newcclosure(function(...))
    local method = getnamecallmethod()
    local self = ...
    if method == 'Sit' and typeof(self) == 'Instance' and self:IsA('Seat') then
        return nil
    end
    if method == 'Raycast' and self == workspace and not checkcaller() then
        if silentAimEnabled or rageEnabled then
            local args = {...}
            local rp = args[4]
            local isBulletRay = typeof(rp) == 'RaycastParams'
                and rp.CollisionGroup == 'ClientBullet'
                or (typeof(rp) == 'RaycastParams'
                    and typeof(rp.FilterDescendantsInstances) == 'table'
                    and #rp.FilterDescendantsInstances == 2)

            if isBulletRay then
                local target
                if silentAimEnabled then
                    target = getSilentAimTarget()
                end
                if not target and rageEnabled then
                    target = closestHitPart
                end
                if target and target.Parent then
                    local origin = args[2]
                    args[3] = (target.Position - origin).Unit * 1000
                    return oldNamecall(unpack(args))
                end
            end
        end
    end
    if method == 'GetAttributes' then
        local attrs = oldNamecall(...)
        if typeof(attrs) == 'table' and typeof(self) == 'Instance' and self:IsA('Tool') and self:GetAttribute('ToolType') == 'Gun' then
            if rapidFireEnabled then
                attrs.FireRate = getEffectiveFireRate()
                attrs.AutoFire = true
            end
            if noSpreadEnabled then
                attrs.SpreadRadius = 0
            end
            if noRecoilEnabled then
                for _, name in ipairs(RECOIL_ATTRS) do
                    if attrs[name] ~= nil then
                        attrs[name] = 0
                    end
                end
            end
        end
        return attrs
    end
    return oldNamecall(...)
end))
