fovStroke.Parent = fovCircle

local function updateFOVCircle()
    local size = silentAimFOVRadius * 2
    fovCircle.Size = UDim2.fromOffset(size, size)
    fovCircle.Visible = silentAimFOVVisible and silentAimEnabled
end

updateFOVCircle()

RunService.RenderStepped:Connect(function()
    if not silentAimEnabled or not silentAimFOVVisible then return end
    local mouse = UserInputService:GetMouseLocation()
    fovCircle.Position = UDim2.fromOffset(mouse.X, mouse.Y)
end)

